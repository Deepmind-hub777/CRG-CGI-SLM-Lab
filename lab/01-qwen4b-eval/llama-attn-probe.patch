+extern "C" int llama_probe_attn(struct llama_context * ctx, const char * path) {
+    (void) ctx;
+    FILE * f = fopen(path, "wb");
+    if (!f) {
+        return -1;
+    }
+    int32_t n = (int32_t) g_attn_tensors.size();
+    fwrite(&n, sizeof(n), 1, f);
+    for (const auto & kv : g_attn_tensors) {
+        const int32_t layer = (int32_t) kv.first;
+        const int32_t type  = (int32_t) kv.second->type;
+        const int32_t ndim  = 4;
+        int64_t ne[4] = {1, 1, 1, 1};
+        for (int i = 0; i < 4; ++i) {
+            ne[i] = kv.second->ne[i];
+        }
+        fwrite(&layer, sizeof(layer), 1, f);
+        fwrite(&type,  sizeof(type),  1, f);
+        fwrite(&ndim,  sizeof(ndim),  1, f);
+        fwrite(ne,     sizeof(ne[0]), 4, f);
+        const size_t bytes = ggml_nbytes(kv.second);
+        std::vector<uint8_t> buf(bytes);
+        ggml_backend_tensor_get(kv.second, buf.data(), 0, bytes);
+        fwrite(buf.data(), 1, bytes, f);
+    }
+    fclose(f);
+    return 0;
+}
