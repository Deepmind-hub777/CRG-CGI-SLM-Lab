{
  "version": "contract-v1",
  "frozen_at": "2026-11-27",
  "purpose": "Single rubric for structural + schema + full-triple checks. Do not compare scores produced under different rubrics.",
  "structural": {
    "root": "single JSON object",
    "no_code_fence": true,
    "top_level_verdict": ["PASS", "HOLD"],
    "claims": "list",
    "duplicate_keys": "forbidden",
    "trailing_tokens": "forbidden",
    "truncated": "forbidden"
  },
  "schema": {
    "required_claim_fields": [
      "claim_id",
      "subject",
      "predicate",
      "object",
      "polarity",
      "kind",
      "evidence"
    ],
    "polarity_values": [1, -1],
    "kind_values": [
      "assertion",
      "antecedent",
      "consequent",
      "hypothetical",
      "interrogative"
    ],
    "empty_claims_allowed_for_hold": true,
    "empty_claims_allowed_for_pass": false
  },
  "full_triple": {
    "non_empty_fields": [
      "claim_id",
      "subject",
      "predicate",
      "object",
      "evidence"
    ],
    "note": "Schema may pass while full triples are still empty; report both."
  },
  "failure_classes": [
    "fence",
    "bad_json",
    "truncated",
    "trailing",
    "dupkey",
    "array_root",
    "missing_verdict",
    "bad_verdict",
    "bad_claims",
    "missing_field",
    "bad_polarity",
    "bad_kind",
    "empty_claim_id",
    "empty_subject",
    "empty_predicate",
    "empty_object",
    "empty_evidence",
    "empty_claims_pass",
    "claim_not_object"
  ],
  "metrics": [
    "structural_pass",
    "schema_pass",
    "triple_pass",
    "structural_and_schema_pass",
    "verdict_accuracy",
    "hold_recall",
    "always_pass_baseline",
    "claim_set_exact"
  ]
}
